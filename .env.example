NODE_ENV=development

# API
API_PORT=4000
REALTIME_PORT=4001
PUBLIC_API_URL=http://localhost:4000
PUBLIC_REALTIME_URL=ws://localhost:4001

# Supabase
SUPABASE_URL=https://wgtxlfswdzwovipyrkfh.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://fixnote:fixnote-local@localhost:5432/fixnote
DIRECT_URL=postgresql://fixnote:fixnote-local@localhost:5432/fixnote

# One-time Auth setup only. Keep these server-side and remove them after running
# scripts/configure-supabase-auth-template.ps1.
SUPABASE_ACCESS_TOKEN=
RESEND_API_KEY=
FIXNOTE_AUTH_FROM_EMAIL=login@auth.example.com

# Local development only. Production must use Supabase JWT validation.
AUTH_MODE=mock
AUTH_MOCK_USER_ID=00000000-0000-4000-8000-000000000001

# 32 random bytes encoded as base64. Never reuse the legacy fix-note key.
FIXNOTE_KEK_VERSION=1
FIXNOTE_KEK_V1=

# DeepSeek is invoked only by explicit user AI actions.
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Self-hosted services inherited from the legacy architecture.
EMBEDDINGS_API_URL=http://localhost:8080
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
EMBEDDINGS_DIMENSIONS=768
WHISPER_API_URL=http://localhost:9000
WHISPER_MODEL=small
REDIS_URL=redis://localhost:6379

# Desktop
VITE_API_URL=http://localhost:4000/api/v1
VITE_REALTIME_URL=ws://localhost:4001
VITE_SUPABASE_URL=https://wgtxlfswdzwovipyrkfh.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_MODE=mock
VITE_MOCK_USER_ID=00000000-0000-4000-8000-000000000001
