{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FixNote",
  "version": "0.1.0",
  "identifier": "app.fixnote.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FixNote",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": false,
        "dragDropEnabled": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
